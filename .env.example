# Copy to .env (git-ignored) and fill in. Never commit real values.

# Anthropic API key from console.anthropic.com — set a monthly spend limit there.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Privacy: LangChain/LangGraph can send traces to LangSmith (a hosted service).
# lango keeps this OFF. Conversations must never leave this app except to the Anthropic API.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
