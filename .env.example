# Copy to .env (git-ignored) and fill in. Never commit real values.

# Anthropic API key from console.anthropic.com. Set a monthly spend limit there. Must start with sk-ant-.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional. Defaults shown. Only these values are accepted (see src/lango/config.py).
# LANGO_MODEL=claude-sonnet-5          # or claude-haiku-4-5-20251001 (faster)
# LANGO_MY_LANGUAGE=en
# LANGO_THEIR_LANGUAGE=vi

# ── Privacy (see tickets/LG-002) ────────────────────────────────────────────────────────
# lango sends conversation text ONLY to the Anthropic API.
# These are intentionally UNSUPPORTED. Don't set them; LG-016 strips them at startup:
#   LANGSMITH_TRACING / LANGCHAIN_TRACING_V2 / LANGSMITH_API_KEY   (would send traces to LangSmith)
#   LANGSMITH_GATEWAY                                              (would route model calls via LangChain's gateway)
#   ANTHROPIC_BASE_URL / ANTHROPIC_API_URL / ANTHROPIC_PROXY       (would redirect model calls elsewhere)
#   ANTHROPIC_LOG                                                  (would log full conversations)
#   HTTP(S)_PROXY / ALL_PROXY / SSL_CERT_FILE / SSL_CERT_DIR         (would expose traffic to a proxy)
# Full list: lango.privacy.BLOCKED_ENV_VARS.
# lango forces tracing off in code and pins the Anthropic address (lango.config.ANTHROPIC_BASE_URL).
# There's nothing to set here.
